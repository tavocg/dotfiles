{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "apps": [
    {
      "name": "Desktop",
      "image-path": "desktop.png"
    },
    {
      "name": "Steam",
      "detached": [
        "sh -c \"exec gamescope -e -f -W \\\"${SUNSHINE_CLIENT_WIDTH:-1920}\\\" -H \\\"${SUNSHINE_CLIENT_HEIGHT:-1080}\\\" -r \\\"${SUNSHINE_CLIENT_FPS:-60}\\\" -o \\\"${SUNSHINE_CLIENT_FPS:-60}\\\" -- steam -gamepadui\""
      ],
      "prep-cmd": [
        {
          "do": "",
          "undo": "sh -c \"setsid steam steam://close/bigpicture >/dev/null 2>&1 || true\npkill -f '[g]amescope.*-- steam -gamepadui' || true\""
        }
      ],
      "image-path": "steam.png"
    }
  ]
}
